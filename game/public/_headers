# Cloudflare static-asset headers.
#
# The world package is the heaviest thing a player downloads and it barely changes,
# yet it was being served `max-age=0, must-revalidate` — so every visit revalidated
# the terrain before the game could start.

/assets/index-*
  Cache-Control: public, max-age=31536000, immutable

/assets/world/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/avatars/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The entry document must never be held anywhere.
#
# Two things were wrong here and both mattered. It matched only `/index.html`, and the
# path a player actually requests is `/` — so the root, which is the file that NAMES which
# bundle to load, had no rule at all. And `max-age=0, must-revalidate` still lets an edge
# keep a copy: measured `cf-cache-status: HIT` on the root while the hashed assets it
# points at were MISS, which is precisely backwards.
#
# `no-store` is unambiguous. The file is 22KB and it is the one thing that must always be
# current; everything expensive it references is hashed and cached for a year above.

/
  Cache-Control: no-store, must-revalidate
  X-Robots-Tag: all

/index.html
  Cache-Control: no-store, must-revalidate
