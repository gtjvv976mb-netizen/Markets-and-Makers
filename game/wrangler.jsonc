{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "markets-and-makers-game",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "www.markets-makers.com", "custom_domain": true }
  ]
}
