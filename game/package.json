{
  "name": "markets-and-makers-browser-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate:art": "node ../scripts/validate-official-art.mjs",
    "validate:businesses-v2": "vite-node ../scripts/validate-businesses-v2.ts",
    "validate:world": "node ../scripts/validate-highlands-browser-assets.mjs",
    "build": "npm run validate:art && npm run validate:businesses-v2 && npm run validate:world && npm run validate:assets && node ../scripts/stamp-world-version.mjs && tsc --noEmit && vite build",
    "deploy:cloudflare": "npm run build && wrangler deploy && npm run deploy:verify",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "validate:assets": "node ../scripts/validate-runtime-assets.mjs",
    "deploy:verify": "node ../scripts/verify-live-deploy.mjs",
    "export:plots": "vite-node ../scripts/export-plots.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  }
}
