{
  "name": "markets-and-makers-browser-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate:art": "node ../scripts/validate-official-art.mjs",
    "validate:world": "node ../scripts/validate-highlands-browser-assets.mjs",
    "build": "npm run validate:art && npm run validate:world && node ../scripts/stamp-world-version.mjs && tsc --noEmit && vite build",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  }
}
